---
import { CALORIE_STATUS_LABELS } from '@elance/contracts'
import { badgeVariants } from '@elance/ui'

import type { CalorieStatus } from '@elance/contracts'

interface Props {
	status: CalorieStatus
}

const { status } = Astro.props
---

<span class={badgeVariants({ tone: status === 'surplus' ? 'warning' : 'positive' })}>
	{CALORIE_STATUS_LABELS[status]}
</span>
